# Referencia de nombres únicamente. Kiro NO carga automáticamente este archivo.
# Define estos valores en el entorno del proceso Kiro y aprueba sus nombres en
# Settings -> Mcp Approved Env Vars. Nunca guardes credenciales reales aquí.
DARKNET_MCP_TOKEN=
REMNUX_MCP_TOKEN=
GHIDRA_MCP_BASIC_AUTH=
RADARE2_MCP_TOKEN=
X64DBG_MCP_BASIC_AUTH=

# Colector Microsoft Graph (engine/graph_import.py). Exportar en la shell que
# ejecuta el importador; no son variables MCP. Permiso de aplicación: Mail.Read,
# restringido al buzón de reportes.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
# Opcional, por defecto inbox
GRAPH_FOLDER=

# Reputación VirusTotal (engine/reputation.py). Solo lectura: nunca sube archivos
# ni solicita escaneos. Con clave pública: 4 consultas/min y 500/día.
VT_API_KEY=
