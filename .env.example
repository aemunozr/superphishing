# Referencia de nombres únicamente. Kiro NO carga automáticamente este archivo.
# Define estos valores en el entorno del proceso Kiro y aprueba sus nombres en
# Settings -> Mcp Approved Env Vars. Nunca guardes credenciales reales aquí.
DARKNET_MCP_TOKEN=
REMNUX_MCP_TOKEN=
GHIDRA_MCP_BASIC_AUTH=
RADARE2_MCP_TOKEN=
X64DBG_MCP_BASIC_AUTH=

# Colector Microsoft Graph (engine/graph_import.py). Exportar en la shell que
# ejecuta el importador; no son variables MCP. Permiso de aplicación: Mail.Read,
# restringido al buzón de reportes.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
# Opcional, por defecto inbox
GRAPH_FOLDER=

# Reputación VirusTotal (engine/reputation.py). Solo lectura: nunca sube archivos
# ni solicita escaneos. Con clave pública: 4 consultas/min y 500/día.
VT_API_KEY=

# Envío de adjuntos de riesgo a REMnux (engine/remnux_stage.py, también desde la
# ingesta antes de marcar READY). Las tools MCP de REMnux solo ven su propio host,
# así que el motor deja allí la muestra y el agente la analiza por ruta.
# copy = carpeta local/montada/UNC que es <muestras REMnux>/<SUBDIR>
# scp  = OpenSSH (Windows/Ubuntu); la clave del host debe estar en known_hosts
REMNUX_STAGE_MODE=off
REMNUX_STAGE_SUBDIR=cases
REMNUX_STAGE_SAMPLES_DIR=/home/remnux/files/samples
REMNUX_STAGE_DIR=
REMNUX_STAGE_SSH_TARGET=
REMNUX_STAGE_REMOTE_DIR=
REMNUX_STAGE_SSH_PORT=22
REMNUX_STAGE_SSH_KEY=
REMNUX_STAGE_KNOWN_HOSTS=
