{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ghidra": {
      "type": "streamable-http",
      "url": "https://mcp.teamprimate.com/ghidra/mcp",
      "headers": {
        "Authorization": "Basic ${GHIDRA_MCP_BASIC_AUTH}"
      }
    },
    "radare2": {
      "type": "streamable-http",
      "url": "https://mcp.teamprimate.com/radare2/mcp",
      "headers": {
        "Authorization": "Bearer ${RADARE2_MCP_TOKEN}"
      }
    }
  }
}
