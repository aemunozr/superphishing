{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "darknet": {
      "type": "streamable-http",
      "url": "https://mcp.teamprimate.com/darknet/mcp",
      "headers": {
        "Authorization": "Bearer ${DARKNET_MCP_TOKEN}"
      }
    },
    "gti-agentic": {
      "type": "streamable-http",
      "url": "https://www.virustotal.com/api/v3/agentspace/mcp/",
      "headers": {
        "x-apikey": "${GTI_MCP_API_KEY}"
      }
    }
  }
}
