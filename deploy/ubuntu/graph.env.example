# Copiar a /etc/superphishing/graph.env con permisos 0640 root:superphishing.
# Nunca subir este archivo con valores reales al repositorio.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_FOLDER=inbox

# Envío de adjuntos de riesgo a REMnux durante la ingesta (engine/remnux_stage.py).
# scp: clave y known_hosts fuera de ~ (el servicio usa ProtectHome=yes), p. ej.
#   install -m 0640 -o root -g superphishing remnux_ed25519 /etc/superphishing/
#   ssh-keyscan -p 22 remnux.host > /etc/superphishing/remnux_known_hosts
# copy: añade la ruta montada a ReadWritePaths del servicio.
REMNUX_STAGE_MODE=off
REMNUX_STAGE_SUBDIR=cases
REMNUX_STAGE_SAMPLES_DIR=/home/remnux/files/samples
REMNUX_STAGE_DIR=
REMNUX_STAGE_SSH_TARGET=
REMNUX_STAGE_REMOTE_DIR=
REMNUX_STAGE_SSH_PORT=22
REMNUX_STAGE_SSH_KEY=/etc/superphishing/remnux_ed25519
REMNUX_STAGE_KNOWN_HOSTS=/etc/superphishing/remnux_known_hosts
